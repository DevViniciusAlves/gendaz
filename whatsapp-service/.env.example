# Porta do servico (padrao 3001 se ausente)
PORT=3001
# Token compartilhado com o backend Spring para futuros endpoints internos.
# Nunca commitar valor real; configurar via ambiente do provedor de deploy.
WHATSAPP_INTERNAL_TOKEN=troque-este-token
# Base do backend Spring para o callback interno de entrega
# (POST {GENDAZ_BACKEND_URL}/internal/whatsapp/delivery).
# Sem valor, o callback e ignorado com aviso (fail-safe).
GENDAZ_BACKEND_URL=http://localhost:8080

# === Autenticacao/Sessao WhatsApp ===
# Armazenamento: file (desenvolvimento/local) ou postgres (producao/stage implantado)
WHATSAPP_AUTH_STORE=file
# URL do PostgreSQL/Neon (obrigatorio quando WHATSAPP_AUTH_STORE=postgres)
# Nunca commitar valor real; configurar via secrets do provedor de deploy.
WHATSAPP_DATABASE_URL=
# Chave de criptografia AES-256-GCM em base64 (32 bytes = 44 chars base64).
# Obrigatorio quando WHATSAPP_AUTH_STORE=postgres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=
# Cooldown (ms) apos esgotar tentativas rapidas de reconexao antes de permitir
# nova rodada de recuperacao demand-driven (status/send).
WHATSAPP_RECONNECT_RECOVERY_COOLDOWN_MS=60000
