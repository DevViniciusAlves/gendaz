SPRING_PROFILES_ACTIVE=prod
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://example-neon-host.neon.tech:5432/example_database?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=example_user
SPRING_DATASOURCE_PASSWORD=example_password
JWT_SECRET=replace-with-render-secret-value
FRONTEND_URL=https://example.pages.dev
JPA_DDL_AUTO=update
PAYMENT_PROVIDER=CAKTO
CAKTO_CLIENT_ID=replace-with-cakto-client-id
CAKTO_CLIENT_SECRET=replace-with-cakto-client-secret
CAKTO_WEBHOOK_SECRET=replace-with-cakto-webhook-secret
CAKTO_PRODUCT_BASICO_ID=replace-with-cakto-basic-product-id
CAKTO_PRODUCT_PRO_ID=replace-with-cakto-pro-product-id
CAKTO_CHECKOUT_BASICO_URL=https://checkout.cakto.example/basic
CAKTO_CHECKOUT_PRO_URL=https://checkout.cakto.example/pro
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
PAYMENT_SUCCESS_URL=https://example.pages.dev/pagamento/sucesso
PAYMENT_CANCEL_URL=https://example.pages.dev/pagamento/cancelado
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-admin-password
SUPER_ADMIN_FORCE_PASSWORD_RESET=false
APP_SEED_TEST_DATA=false
WHATSAPP_SERVICE_URL=https://seu-whatsapp-service.onrender.com
WHATSAPP_INTERNAL_TOKEN=troque-este-token
