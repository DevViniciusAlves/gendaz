name: Keep Alive - Render

on:
  schedule:
    - cron: '*/5 * * * *'  # A cada 5 minutos
  workflow_dispatch:  # Permite rodar manualmente também

jobs:
  keep-alive:
    runs-on: ubuntu-latest
    steps:
      - name: Ping backend
        run: curl -f https://seu-backend-gendaz.onrender.com/health || true
        
      - name: Ping whatsapp-service
        run: curl -f https://seu-whatsapp-gendaz.onrender.com/health || true
